// Shaman Kathmandu CMS schema.
// Each model is shaped so an API route can return JSON that satisfies the
// matching interface in lib/api/types.ts without any frontend changes.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model AdminUser {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  name            String?
  // owner = full access incl. user management; editor = content CRUD;
  // viewer = read-only. Enforced server-side via requireRole().
  role            String               @default("editor")
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  resetTokens     PasswordResetToken[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ─── Site / Homepage singletons ──────────────────────────────────────────────

model SiteConfig {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model HomepageConfig {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

// ─── Elements (the six nature elements) ──────────────────────────────────────

model Element {
  slug                String  @id
  name                String
  icon                String
  accent              String
  natureSource        String
  energyDescription   String
  position            Int     @default(0)
  // Nepali translations (null/empty → fall back to the English column).
  nameNe              String?
  natureSourceNe      String?
  energyDescriptionNe String?
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  nameNe    String? // Nepali translation; falls back to `name`
  imageUrl  String?
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String              @id @default(cuid())
  slug             String              @unique
  name             String
  nameNe           String? // Nepali; falls back to `name`
  description      String // markdown
  descriptionNe    String? // Nepali markdown; falls back to `description`
  sku              String? // optional product-level SKU (not unique)
  price            Int // store in NPR rupees (whole units, matches mock data)
  compareAtPrice   Int?
  currency         String              @default("NPR")
  stockQuantity    Int? // product-level stock; null = untracked (always available). Variant products track stock per ProductVariation.
  dimensions       Json? // JSON: length, width, height, diameter, weight (all optional), unit cm|in, weightUnit g|kg, note
  thumbnailUrl     String?
  vendorId         String?
  elementSlugs     String[]            @default([])
  isFeatured       Boolean             @default(false)
  isNewRelease     Boolean             @default(false)
  priceOnEnquiry   Boolean             @default(false)
  position         Int                 @default(0)
  status           String              @default("published") // draft | published | archived
  publishedAt      DateTime?
  tags             String[]            @default([])
  categoryId       String?
  seoTitle         String?
  seoTitleNe       String?
  seoDescription   String?
  seoDescriptionNe String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean             @default(false)
  twitterCard      String?             @default("summary_large_image")
  lastEditedBy     String?
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variations       ProductVariation[]
  reviews          Review[]
  bundleItems      BundleItem[]
  collectionLinks  CollectionProduct[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([categoryId])
  @@index([elementSlugs], type: Gin)
  @@index([isFeatured])
  @@index([status])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  altNe     String?
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariation {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String
  price      Int
  stock      Int     @default(0)
  attributes Json    @default("{}")

  @@index([productId])
}

model Review {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating      Int
  title       String
  body        String
  authorName  String
  authorEmail String?
  isApproved  Boolean   @default(false)
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime  @default(now())

  @@index([productId])
  @@index([isApproved])
}

// ─── Bundles ─────────────────────────────────────────────────────────────────

model Bundle {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  titleNe          String?
  description      String?
  descriptionNe    String?
  price            Int
  compareAtPrice   Int?
  thumbnailUrl     String?
  position         Int          @default(0)
  seoTitle         String?
  seoTitleNe       String?
  seoDescription   String?
  seoDescriptionNe String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean      @default(false)
  twitterCard      String?      @default("summary_large_image")
  items            BundleItem[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  position  Int     @default(0)

  @@index([bundleId])
  @@index([productId])
}

// ─── Collections ─────────────────────────────────────────────────────────────

model Collection {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  titleNe          String?
  subtitle         String?
  subtitleNe       String?
  heroImageUrl     String?
  position         Int                 @default(0)
  seoTitle         String?
  seoTitleNe       String?
  seoDescription   String?
  seoDescriptionNe String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean             @default(false)
  twitterCard      String?             @default("summary_large_image")
  products         CollectionProduct[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
}

// ─── Blog ────────────────────────────────────────────────────────────────────

model BlogCategory {
  slug          String     @id
  name          String
  nameNe        String?
  description   String?
  descriptionNe String?
  posts         BlogPost[]
}

model BlogPost {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  titleNe           String?
  excerpt           String
  excerptNe         String?
  bodyMarkdown      String
  bodyMarkdownNe    String?
  heroImageUrl      String?
  heroVideoEmbedUrl String?
  authorName        String
  categorySlug      String?
  category          BlogCategory? @relation(fields: [categorySlug], references: [slug], onDelete: SetNull)
  tags              String[]      @default([])
  isFeatured        Boolean       @default(false)
  status            String        @default("draft") // draft | published
  publishedAt       DateTime?
  readingMinutes    Int           @default(3)
  seoTitle          String?
  seoTitleNe        String?
  seoDescription    String?
  seoDescriptionNe  String?
  ogImageUrl        String?
  canonicalUrl      String?
  noindex           Boolean       @default(false)
  twitterCard       String?       @default("summary_large_image")
  lastEditedBy      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([categorySlug])
  @@index([isFeatured])
  @@index([status])
  @@index([createdAt])
}

// ─── CMS pages (about / faq / privacy / terms / custom) ──────────────────────

model Page {
  slug             String   @id
  title            String
  titleNe          String?
  bodyMarkdown     String
  bodyMarkdownNe   String?
  publishedAt      DateTime @default(now())
  seoTitle         String?
  seoTitleNe       String?
  seoDescription   String?
  seoDescriptionNe String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean  @default(false)
  twitterCard      String?  @default("summary_large_image")
  lastEditedBy     String?
  updatedAt        DateTime @updatedAt
}

// ─── Services ────────────────────────────────────────────────────────────────

model Service {
  slug                String   @id
  name                String
  nameNe              String?
  element             String
  duration            String
  durationNe          String?
  pricePerSession     Int
  hero                String?
  summary             String
  summaryNe           String?
  whatToExpect        Json     @default("[]")
  whatToExpectNe      Json?
  relatedProductSlugs String[] @default([])
  position            Int      @default(0)
  seoTitle            String?
  seoTitleNe          String?
  seoDescription      String?
  seoDescriptionNe    String?
  ogImageUrl          String?
  canonicalUrl        String?
  noindex             Boolean  @default(false)
  twitterCard         String?  @default("summary_large_image")
  updatedAt           DateTime @updatedAt
}

// ─── Showrooms ───────────────────────────────────────────────────────────────

model Showroom {
  key         String   @id
  name        String
  nameNe      String?
  address     String
  addressNe   String?
  whatsapp    String
  mapEmbedUrl String?
  position    Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ─── Media library (R2) ──────────────────────────────────────────────────────

model Media {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  mime      String
  bytes     Int
  width     Int?
  height    Int?
  alt       String?
  createdAt DateTime @default(now())
}

// ─── URL redirects (managed via /sysuser/redirects) ──────────────────────────

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(308)
  enabled    Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Admin activity log (lightweight, append-only) ───────────────────────────

model AdminLog {
  id        String   @id @default(cuid())
  actor     String // admin email
  action    String // "create" | "update" | "delete" | "publish" | etc.
  entity    String // "Product" | "BlogPost" | "Page" | …
  entityId  String?
  summary   String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([actor])
}

// ─── MCP access tokens (Bearer auth for /api/mcp) ────────────────────────────
// Opaque tokens shown once at creation; only the SHA-256 hash is stored.
// Revoking sets revokedAt — the row is kept for the audit trail.

model McpToken {
  id         String    @id @default(cuid())
  name       String // human label, e.g. "claude-desktop"
  tokenHash  String    @unique // sha256(token), hex
  role       String    @default("editor") // "owner" | "editor" | "viewer"
  createdBy  String // admin email
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
}

// ─── Customers (storefront accounts) ─────────────────────────────────────────

model Customer {
  id           String                       @id @default(cuid())
  email        String                       @unique
  passwordHash String
  name         String
  phone        String?
  lastLoginAt  DateTime?
  resetTokens  CustomerPasswordResetToken[]
  orders       Order[]
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
}

model CustomerPasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// ─── Orders (COD checkout) ───────────────────────────────────────────────────
// Delivery address is inlined (no address book in v1). Item rows snapshot the
// product name/price at order time so later catalog edits don't rewrite
// history. Status flow: pending → confirmed → shipped → delivered, with
// cancelled reachable from pending/confirmed (see lib/orders).

model Order {
  id              String             @id @default(cuid())
  number          String             @unique // human-readable, e.g. "SK-000042"
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  subtotal        Int // NPR rupees, sum of item price × qty
  total           Int // = subtotal in v1 (no delivery fee / discounts yet)
  status          String             @default("pending") // pending | confirmed | shipped | delivered | cancelled
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryZone    String // thamel | jhamsikhel | gongabu | shipping
  deliveryNotes   String?
  paymentMethod   String             @default("cod")
  paymentStatus   String             @default("pending") // pending | completed
  statusEvents    OrderStatusEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  productSlug  String
  productName  String // snapshot at order time
  thumbnailUrl String?
  variationId  String?
  variationSku String?
  quantity     Int
  priceAtOrder Int // NPR rupees, snapshot at order time

  @@index([orderId])
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  notes     String?
  createdBy String // admin email, MCP token name, or "customer"
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Single-row atomic counter for human-readable order numbers. Incremented
// inside the order-creation transaction so concurrent checkouts can't collide.
model OrderCounter {
  id    Int @id @default(1)
  value Int @default(0)
}

// ─── Customer activity log (mirror of AdminLog; also feeds rate limiting) ────

model CustomerLog {
  id        String   @id @default(cuid())
  actor     String // customer email
  action    String // "register" | "login" | "login_failed" | "order_placed" | …
  entity    String // "Customer" | "Order" | …
  entityId  String?
  summary   String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([actor, action, createdAt])
}

// ─── Announcement bar (singleton row, gated by `announcementBar` module) ────

model Announcement {
  id          Int      @id @default(1)
  enabled     Boolean  @default(false)
  message     String
  messageNe   String?
  href        String?
  bgColor     String   @default("#c4a35a")
  fgColor     String   @default("#0a0806")
  dismissable Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}
