// Shaman Kathmandu CMS schema.
// Each model is shaped so an API route can return JSON that satisfies the
// matching interface in lib/api/types.ts without any frontend changes.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model AdminUser {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  name            String?
  // owner = full access incl. user management; editor = content CRUD;
  // staff = reporting/operations entry (CRM, sales, stock, footfall);
  // viewer = read-only. Enforced server-side via requireRole().
  // Default is least-privilege "staff"; existing rows keep their stored role.
  role            String               @default("staff")
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  resetTokens     PasswordResetToken[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  oauthApprovals     OAuthAuthorizationRequest[]
  oauthRefreshTokens OAuthRefreshToken[]
  staff              Staff?
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ─── Site / Homepage singletons ──────────────────────────────────────────────

model SiteConfig {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model HomepageConfig {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

// ─── Elements (the six nature elements) ──────────────────────────────────────

model Element {
  slug                String  @id
  name                String
  icon                String
  accent              String
  natureSource        String
  energyDescription   String
  position            Int     @default(0)
  // Nepali translations (null/empty → fall back to the English column).
  nameNe              String?
  natureSourceNe      String?
  energyDescriptionNe String?
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  nameNe    String? // Nepali translation; falls back to `name`
  imageUrl  String?
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String              @id @default(cuid())
  slug             String              @unique
  name             String
  nameNe           String? // Nepali; falls back to `name`
  description      String // markdown
  descriptionNe    String? // Nepali markdown; falls back to `description`
  sku              String? // optional product-level SKU (not unique)
  price            Int // store in NPR rupees (whole units, matches mock data)
  compareAtPrice   Int?
  currency         String              @default("NPR")
  stockQuantity    Int? // product-level stock; null = untracked (always available). Variant products track stock per ProductVariation.
  dimensions       Json? // JSON: length, width, height, diameter, weight (all optional), unit cm|in, weightUnit g|kg, note
  thumbnailUrl     String?
  vendorId         String?
  elementSlugs     String[]            @default([])
  isFeatured       Boolean             @default(false)
  isNewRelease     Boolean             @default(false)
  priceOnEnquiry   Boolean             @default(false)
  position         Int                 @default(0)
  status           String              @default("published") // draft | published | archived
  publishedAt      DateTime?
  tags             String[]            @default([])
  categoryId       String?
  seoTitle         String?
  seoTitleNe       String?
  seoDescription   String?
  seoDescriptionNe String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean             @default(false)
  twitterCard      String?             @default("summary_large_image")
  lastEditedBy     String?
  // ── Reporting-system fields (admin/MCP only — NEVER in public DTOs/feeds) ──
  legacyImsCode    String?             @unique // join key for historical IMS data (575 codes)
  qrPayload        String?             @unique // one QR per SKU (product); encodes "SKM:<legacyImsCode|id>"
  wholesaleEnabled Boolean             @default(false) // curates the public /wholesale catalog
  wholesalePrice   Int? // base trade rate, NPR — hidden everywhere public; enquire to get price
  moq              Int? // minimum order quantity (product level), shown in /wholesale
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variations       ProductVariation[]
  reviews          Review[]
  bundleItems      BundleItem[]
  collectionLinks  CollectionProduct[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  saleLines        SaleLine[]
  b2bQuoteLines    B2bQuoteLine[]

  @@index([categoryId])
  @@index([elementSlugs], type: Gin)
  @@index([isFeatured])
  @@index([status])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  altNe     String?
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariation {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String
  price          Int
  // Materialized Σ of this variation's StockLevel.qty across showrooms.
  // Kept in sync by recordStockMovement() (lib/stock) — never write directly.
  stock          Int     @default(0)
  attributes     Json    @default("{}")
  // ── Reporting-system fields ──
  label          String? // human-readable variant name, e.g. "Blue / Large"
  color          String?
  size           String?
  dimensions     Json? // same shape as Product.dimensions: length, breadth, height, diameter, weight, unit, weightUnit, note
  mrp            Int? // catalog MRP, NPR
  costPrice      Int? // for B2B margin calc, NPR (admin/MCP only)
  wholesalePrice Int? // per-variation override of Product.wholesalePrice (admin/MCP only)
  active         Boolean @default(true)

  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  saleLines         SaleLine[]
  b2bQuoteLines     B2bQuoteLine[]
  footfallInquiries FootfallInquiry[]

  @@index([productId])
}

model Review {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating      Int
  title       String
  body        String
  authorName  String
  authorEmail String?
  isApproved  Boolean   @default(false)
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime  @default(now())

  @@index([productId])
  @@index([isApproved])
}

// ─── Bundles ─────────────────────────────────────────────────────────────────

model Bundle {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  titleNe          String?
  description      String?
  descriptionNe    String?
  price            Int
  compareAtPrice   Int?
  thumbnailUrl     String?
  position         Int          @default(0)
  seoTitle         String?
  seoTitleNe       String?
  seoDescription   String?
  seoDescriptionNe String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean      @default(false)
  twitterCard      String?      @default("summary_large_image")
  items            BundleItem[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  position  Int     @default(0)

  @@index([bundleId])
  @@index([productId])
}

// ─── Collections ─────────────────────────────────────────────────────────────

model Collection {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  titleNe          String?
  subtitle         String?
  subtitleNe       String?
  heroImageUrl     String?
  position         Int                 @default(0)
  seoTitle         String?
  seoTitleNe       String?
  seoDescription   String?
  seoDescriptionNe String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean             @default(false)
  twitterCard      String?             @default("summary_large_image")
  products         CollectionProduct[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
}

// ─── Blog ────────────────────────────────────────────────────────────────────

model BlogCategory {
  slug          String     @id
  name          String
  nameNe        String?
  description   String?
  descriptionNe String?
  posts         BlogPost[]
}

model BlogPost {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  titleNe           String?
  excerpt           String
  excerptNe         String?
  bodyMarkdown      String
  bodyMarkdownNe    String?
  heroImageUrl      String?
  heroVideoEmbedUrl String?
  authorName        String
  categorySlug      String?
  category          BlogCategory? @relation(fields: [categorySlug], references: [slug], onDelete: SetNull)
  tags              String[]      @default([])
  isFeatured        Boolean       @default(false)
  status            String        @default("draft") // draft | published
  publishedAt       DateTime?
  readingMinutes    Int           @default(3)
  seoTitle          String?
  seoTitleNe        String?
  seoDescription    String?
  seoDescriptionNe  String?
  ogImageUrl        String?
  canonicalUrl      String?
  noindex           Boolean       @default(false)
  twitterCard       String?       @default("summary_large_image")
  lastEditedBy      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([categorySlug])
  @@index([isFeatured])
  @@index([status])
  @@index([createdAt])
}

// ─── CMS pages (about / faq / privacy / terms / custom) ──────────────────────

model Page {
  slug             String   @id
  title            String
  titleNe          String?
  bodyMarkdown     String
  bodyMarkdownNe   String?
  publishedAt      DateTime @default(now())
  seoTitle         String?
  seoTitleNe       String?
  seoDescription   String?
  seoDescriptionNe String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean  @default(false)
  twitterCard      String?  @default("summary_large_image")
  lastEditedBy     String?
  updatedAt        DateTime @updatedAt
}

// ─── Services ────────────────────────────────────────────────────────────────

model Service {
  slug                String   @id
  name                String
  nameNe              String?
  element             String
  duration            String
  durationNe          String?
  pricePerSession     Int
  hero                String?
  summary             String
  summaryNe           String?
  whatToExpect        Json     @default("[]")
  whatToExpectNe      Json?
  relatedProductSlugs String[] @default([])
  position            Int      @default(0)
  seoTitle            String?
  seoTitleNe          String?
  seoDescription      String?
  seoDescriptionNe    String?
  ogImageUrl          String?
  canonicalUrl        String?
  noindex             Boolean  @default(false)
  twitterCard         String?  @default("summary_large_image")
  updatedAt           DateTime @updatedAt
}

// ─── Showrooms ───────────────────────────────────────────────────────────────

model Showroom {
  key         String   @id
  name        String
  nameNe      String?
  address     String
  addressNe   String?
  whatsapp    String
  mapEmbedUrl String?
  position    Int      @default(0)
  // ── Reporting-system fields ──
  type        String   @default("showroom") // showroom | warehouse
  active      Boolean  @default(true) // false = closed location; history is kept
  updatedAt   DateTime @updatedAt

  staff          Staff[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  crmLeads       CrmLead[]
  sales          Sale[]
  footfall       FootfallEntry[]
}

// ─── Media library (R2) ──────────────────────────────────────────────────────

model Media {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  mime      String
  bytes     Int
  width     Int?
  height    Int?
  alt       String?
  createdAt DateTime @default(now())
}

// ─── URL redirects (managed via /sysuser/redirects) ──────────────────────────

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(308)
  enabled    Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Admin activity log (lightweight, append-only) ───────────────────────────

model AdminLog {
  id        String   @id @default(cuid())
  actor     String // admin email
  action    String // "create" | "update" | "delete" | "publish" | etc.
  entity    String // "Product" | "BlogPost" | "Page" | …
  entityId  String?
  summary   String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([actor])
}

// ─── MCP access tokens (Bearer auth for /api/mcp) ────────────────────────────
// Opaque tokens shown once at creation; only the SHA-256 hash is stored.
// Revoking sets revokedAt — the row is kept for the audit trail.

model McpToken {
  id            String       @id @default(cuid())
  name          String // human label, e.g. "claude-desktop"
  tokenHash     String       @unique // sha256(token), hex
  role          String       @default("editor") // "owner" | "editor" | "viewer"
  createdBy     String // admin email
  createdAt     DateTime     @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  // Set when minted via the OAuth /token endpoint (null for hand-created
  // tokens). oauthFamilyId groups every access token issued from one grant's
  // refresh-token family so a family kill revokes them all at once.
  oauthClientId String?
  oauthFamilyId String?
  oauthClient   OAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)

  @@index([oauthFamilyId])
}

// ─── OAuth 2.1 for remote MCP connectors (claude.ai / ChatGPT) ────────────────
// DCR (RFC 7591) + PKCE S256 + consent. Access tokens minted through /token are
// ordinary McpToken rows, so verification, revocation, and per-tool roles need
// no OAuth-specific handling.

model OAuthClient {
  id                      String    @id @default(cuid())
  clientId                String    @unique // public identifier handed out at registration
  clientSecretHash        String? // sha256(secret), hex; null for public (PKCE-only) clients
  clientName              String? // self-reported at registration; every claude.ai connector says "Claude"
  // Admin-set nickname, so two connections from the same app (e.g. two Claude
  // accounts) are tellable apart in the connections list. Wins over clientName.
  label                   String?
  redirectUris            String[]
  grantTypes              String[]  @default(["authorization_code", "refresh_token"])
  tokenEndpointAuthMethod String    @default("none") // "none" | "client_secret_basic" | "client_secret_post"
  scope                   String    @default("mcp")
  createdAt               DateTime  @default(now())
  revokedAt               DateTime?

  authorizationRequests OAuthAuthorizationRequest[]
  refreshTokens         OAuthRefreshToken[]
  mcpTokens             McpToken[]
}

// Pending /authorize request; its id is the opaque request_id the consent page
// receives. Approval stamps the approving admin + granted role and mints a
// single-use 60s code. Short-lived (10 min) — expired rows are purged
// opportunistically on the next /authorize.
model OAuthAuthorizationRequest {
  id               String    @id @default(cuid())
  clientId         String
  redirectUri      String
  state            String?
  scope            String
  resource         String? // RFC 8707 resource indicator; must be the MCP endpoint URL
  codeChallenge    String // PKCE, S256 only
  codeHash         String?   @unique // sha256(code), hex — set at approval; single-use
  codeUsedAt       DateTime?
  approvedBy       String? // approving admin email (audit)
  approvedByUserId String? // AdminUser.id — the grant acts as this admin
  grantRole        String? // "owner" | "editor" | "viewer", chosen at consent
  approvedAt       DateTime?
  expiresAt        DateTime // 10 min from creation; tightened to 60s at approval
  createdAt        DateTime  @default(now())

  client         OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  approvedByUser AdminUser?  @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

// Opaque refresh token (sha256 hash stored). Rotation: each refresh issues a
// new row in the same familyId and stamps rotatedAt on the old one; reuse of a
// rotated/revoked token revokes the whole family plus its access tokens.
model OAuthRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256(token), hex
  familyId  String
  clientId  String
  userId    String // AdminUser.id of the granting admin
  grantRole String // role stamped on access tokens minted from this grant
  scope     String
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Cascade: deleting an admin kills their grants outright — refresh stops
  // working immediately; any live access tokens die at their 1h expiry.
  user   AdminUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// ─── Customers (storefront accounts) ─────────────────────────────────────────

model Customer {
  id           String                       @id @default(cuid())
  email        String                       @unique
  passwordHash String
  name         String
  phone        String?
  lastLoginAt  DateTime?
  resetTokens  CustomerPasswordResetToken[]
  orders       Order[]
  sales        Sale[]
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
}

model CustomerPasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// ─── Orders (COD checkout) ───────────────────────────────────────────────────
// Delivery address is inlined (no address book in v1). Item rows snapshot the
// product name/price at order time so later catalog edits don't rewrite
// history. Status flow: pending → confirmed → shipped → delivered, with
// cancelled reachable from pending/confirmed (see lib/orders).

model Order {
  id              String             @id @default(cuid())
  number          String             @unique // human-readable, e.g. "SK-000042"
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  subtotal        Int // NPR rupees, sum of item price × qty
  total           Int // = subtotal in v1 (no delivery fee / discounts yet)
  status          String             @default("pending") // pending | confirmed | shipped | delivered | cancelled
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryZone    String // thamel | jhamsikhel | gongabu | shipping
  deliveryNotes   String?
  paymentMethod   String             @default("cod")
  paymentStatus   String             @default("pending") // pending | completed
  statusEvents    OrderStatusEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sale            Sale?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  productSlug  String
  productName  String // snapshot at order time
  thumbnailUrl String?
  variationId  String?
  variationSku String?
  quantity     Int
  priceAtOrder Int // NPR rupees, snapshot at order time

  @@index([orderId])
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  notes     String?
  createdBy String // admin email, MCP token name, or "customer"
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Single-row atomic counter for human-readable order numbers. Incremented
// inside the order-creation transaction so concurrent checkouts can't collide.
model OrderCounter {
  id    Int @id @default(1)
  value Int @default(0)
}

// ─── Customer activity log (mirror of AdminLog; also feeds rate limiting) ────

model CustomerLog {
  id        String   @id @default(cuid())
  actor     String // customer email
  action    String // "register" | "login" | "login_failed" | "order_placed" | …
  entity    String // "Customer" | "Order" | …
  entityId  String?
  summary   String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([actor, action, createdAt])
}

// ─── Announcement bar (singleton row, gated by `announcementBar` module) ────

model Announcement {
  id          Int      @id @default(1)
  enabled     Boolean  @default(false)
  message     String
  messageNe   String?
  href        String?
  bgColor     String   @default("#c4a35a")
  fgColor     String   @default("#0a0806")
  dismissable Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ─── Member Circle join requests (homepage opt-in form; admin-worked queue) ──

model MemberLead {
  id        String   @id @default(cuid())
  name      String
  whatsapp  String
  email     String?
  source    String   @default("homepage-member-circle")
  status    String   @default("new") // new | contacted | activated | rejected
  note      String? // admin notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── Reporting system: staff, lookups, stock ledger (PR 1 — Foundation) ──────
// Spec: vault note "Shaman Kathmandu · Reporting System Spec".
// Rules: append-only ledgers (corrections = new reversing rows, never edits);
// StockLevel.qty and ProductVariation.stock are materialized sums maintained
// exclusively by recordStockMovement() in lib/stock.

model Staff {
  id                 String     @id @default(cuid())
  name               String
  phone              String?
  // 1:1 web login (AdminUser with role "staff"); null until linked.
  adminUserId        String?    @unique
  adminUser          AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  // Telegram bot identity (numeric user id as string); null until registered.
  telegramUserId     String?    @unique
  // null = floater — bots must prompt for showroom at entry time.
  defaultShowroomKey String?
  defaultShowroom    Showroom?  @relation(fields: [defaultShowroomKey], references: [key], onDelete: SetNull)
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now())

  stockMovements     StockMovement[]
  // Two distinct Staff→CrmLead relations, so both must be named.
  crmLeadsCreated    CrmLead[]              @relation("crmLeadCreatedBy")
  crmLeadsAssigned   CrmLead[]              @relation("crmLeadAssignedTo")
  crmStatusChanges   CrmLeadStatusHistory[]
  crmFollowups       CrmFollowup[]
  salesEntered       Sale[]                 @relation("saleEnteredBy")
  saleRoles          SaleStaff[]
  b2bAccountsOwned   B2bAccount[]           @relation("b2bAccountOwner")
  b2bAccountsCreated B2bAccount[]           @relation("b2bAccountCreator")
  b2bDealsOwned      B2bDeal[]              @relation("b2bDealOwner")
  b2bStageChanges    B2bDealStageHistory[]
  b2bPayments        B2bPayment[]
  footfallEntries    FootfallEntry[]
  contentLogs        ContentLog[]
  adSpend            AdSpendDaily[]

  @@index([telegramUserId])
  @@index([active])
}

// Controlled payment vocabulary — fixes the cash/cashh/cshh/csh chaos in the
// existing till registers. Referenced by sales (PR 3) and B2B payments (PR 5).
model PaymentMethodLookup {
  id       String  @id @default(cuid())
  label    String  @unique // e.g. "Cash", "HML QR", "Muktinath eSewa"
  channel  String // cash | qr | card | bank | cod | online
  provider String? // HML | Muktinath | eSewa | FonePay | null
  active   Boolean @default(true)

  sales       Sale[]
  b2bPayments B2bPayment[]
}

// How a lead reached us (separate from interest — spec decision #10).
model LeadSource {
  id     String  @id @default(cuid())
  label  String  @unique // seed: SMS, WhatsApp, Facebook Messenger, Instagram DM, Phone Call, Walk-in, Website, Referral
  active Boolean @default(true)

  crmLeads CrmLead[]
}

model Courier {
  id     String  @id @default(cuid())
  label  String  @unique // seed: inDrive, NCM, Pathao, Self-delivery, Customer pickup
  active Boolean @default(true)
}

// Per-showroom stock snapshot. qty is a materialized Σ of StockMovement.delta
// for this (variation, showroom) — never edited directly.
model StockLevel {
  id          String           @id @default(cuid())
  variationId String
  variation   ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  showroomKey String
  showroom    Showroom         @relation(fields: [showroomKey], references: [key], onDelete: Cascade)
  qty         Int              @default(0)
  updatedAt   DateTime         @updatedAt

  // The separate-pool guarantee (spec decision #7).
  @@unique([variationId, showroomKey])
  @@index([showroomKey])
}

// APPEND-ONLY stock ledger — the source of truth for all inventory changes.
// A miscount is corrected by a new reversing row referencing the original
// (reason "correction", refType "StockMovement", refId = original id).
model StockMovement {
  id          String           @id @default(cuid())
  variationId String
  variation   ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  showroomKey String
  showroom    Showroom         @relation(fields: [showroomKey], references: [key], onDelete: Cascade)
  delta       Int // + in, − out
  reason      String // sale | order | transfer | adjustment | return | correction | initial_seed
  refType     String? // "Sale" | "Order" | "StockMovement" | "Transfer"
  refId       String?
  staffId     String?
  staff       Staff?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime         @default(now())

  @@index([variationId, showroomKey, createdAt])
  @@index([reason])
  @@index([staffId])
  @@index([createdAt])
}

// ─── Reporting system: CRM (PR 2 — Module A) ─────────────────────────────────
// Replaces the WhatsApp daily-tally habit: a day's "New sms – 10, Warm – 3" is
// a QUERY over these rows, never a typed number. Every lead carries a name, a
// phone, a server-generated timestamp and an author, so a day's figures can't
// be inflated or shrunk without fabricating individually-attributable records.
//
// `interest` (retail | wholesale_b2b | custom_order) is deliberately separate
// from `sourceId` (how they reached us) — spec decision #10.

model CrmLead {
  id       String  @id @default(cuid())
  name     String
  phone    String
  phoneAlt String?
  email    String?

  sourceId String     @map("sourceId")
  source   LeadSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  interest String // retail | wholesale_b2b | custom_order
  // hot = actively talking · warm = conversation started, not finalised
  // cold = no reply · dnc = do not contact · purchase = converted (links a sale)
  // new  = raw inflow, still untriaged (keeps daily inflow countable)
  status   String @default("new") // new | hot | warm | cold | purchase | dnc

  askedLocation Boolean   @default(false)
  willVisit     Boolean   @default(false)
  visitDate     DateTime?
  followUpDate  DateTime?

  assignedStaffId String?
  assignedStaff   Staff?  @relation("crmLeadAssignedTo", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  showroomKey String?
  showroom    Showroom? @relation(fields: [showroomKey], references: [key], onDelete: SetNull)

  // Set when status → purchase, and when a wholesale_b2b lead converts to a
  // trade account (spec decision #12).
  linkedSaleId       String?
  // The sale that closed this lead. A real relation, so a discarded draft can
  // never leave a dangling id behind (SetNull) and callers can include it.
  linkedSale         Sale?       @relation("crmLeadClosingSale", fields: [linkedSaleId], references: [id], onDelete: SetNull)
  linkedB2bAccountId String?
  // The account this lead became. Its mirror — B2bAccount.sourceCrmLeadId —
  // is the account's memory of where it came from; convertLeadToAccount() sets
  // both in one transaction so the two directions can't disagree.
  linkedB2bAccount   B2bAccount? @relation("crmLeadLinkedAccount", fields: [linkedB2bAccountId], references: [id], onDelete: SetNull)

  notes       String?
  // Forwarded-chat screenshot etc., retained as evidence (never discarded
  // after reading) — spec's bot non-negotiable, also used by the web form.
  evidenceUrl String?

  createdByStaffId String
  createdByStaff   Staff  @relation("crmLeadCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)

  // Server-generated — the anti-inflation guarantee.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory CrmLeadStatusHistory[]
  followups     CrmFollowup[]
  // Sales recorded against this lead. `linkedSaleId` above is the one that
  // closed it (set when status → purchase); this is the full set.
  sales         Sale[]                 @relation("saleCrmLead")
  // Trade accounts converted from this lead (spec decision #12).
  b2bAccounts   B2bAccount[]           @relation("b2bAccountFromLead")

  @@index([status])
  @@index([interest])
  @@index([sourceId])
  @@index([createdAt])
  @@index([showroomKey])
  @@index([assignedStaffId])
  @@index([followUpDate])
  @@index([phone])
}

// APPEND-ONLY: a status is never overwritten in place, it gains a dated row
// here (spec decision #11). Reports read the history, not the current value.
model CrmLeadStatusHistory {
  id     String  @id @default(cuid())
  leadId String
  lead   CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStatus String? // null on the row written at lead creation
  toStatus   String

  changedByStaffId String
  changedByStaff   Staff  @relation(fields: [changedByStaffId], references: [id], onDelete: Restrict)

  note      String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([createdAt])
}

model CrmFollowup {
  id     String  @id @default(cuid())
  leadId String
  lead   CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  followupAt  DateTime // when the follow-up happened (or is scheduled for)
  channel     String // whatsapp | call | sms | messenger | instagram | in_person
  gotResponse Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([leadId, followupAt])
  @@index([staffId])
  @@index([followupAt])
}

// ─── Reporting system: sales spine (PR 3 — Module B) ─────────────────────────
// ONE table for every channel. The brief's separate asks — online sales,
// Gongabu sales, wholesale, delivery log — are filters over this table, not
// four systems. Reports slice by `channel` + `showroomKey` + date.
//
// Lifecycle: draft → confirmed → (void). A draft touches no stock. Confirming
// decrements the sale's showroom pool through lib/stock in one Serializable
// transaction — all lines or none. A confirmed sale is IMMUTABLE: a mistake is
// corrected by voiding it, which appends a new reversing Sale (amounts negated,
// stock movements reversed) rather than editing history.

model Sale {
  id     String @id @default(cuid())
  // Human-readable, gapless per environment: "SL-000042". Allocated from
  // SaleCounter inside the confirm transaction (same pattern as OrderCounter).
  saleNo String @unique

  channel String // online | showroom | wholesale_b2b | event

  showroomKey String? // which pool the stock comes out of; null until chosen
  showroom    Showroom? @relation(fields: [showroomKey], references: [key], onDelete: SetNull)

  // Who bought. A showroom walk-in has none of these; an online order has a
  // Customer; a wholesale sale carries the trade account.
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  b2bAccountId String?
  b2bAccount   B2bAccount? @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)
  crmLeadId    String? // closes the lead → revenue loop
  crmLead      CrmLead?    @relation("saleCrmLead", fields: [crmLeadId], references: [id], onDelete: SetNull)
  // Set on sales auto-bridged from a website order (PR 4). Unique: one sale per
  // order, which is what makes the bridge idempotent under webhook retries.
  orderId      String?     @unique
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Both calendars, always (spec): dateBs is server-computed in Asia/Kathmandu.
  dateAd DateTime @default(now())
  dateBs String // "2083-04-24"

  // Whole NPR rupees throughout. On a reversing sale these are negated, so
  // summing a period nets to the corrected figure.
  subtotal       Int
  discountAmount Int @default(0)
  deliveryFee    Int @default(0)
  totalAmount    Int

  paymentMethodId    String?
  paymentMethod      PaymentMethodLookup? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  paymentRef         String? // receipt / transaction reference
  paymentEvidenceUrl String? // retained screenshot (the bot asks for it explicitly)

  status String @default("draft") // draft | confirmed | void

  // Correction chain. Set on the reversing sale, pointing at what it reverses;
  // unique, so a confirmed sale can be reversed at most once.
  reversesSaleId String? @unique
  reverses       Sale?   @relation("saleReversal", fields: [reversesSaleId], references: [id], onDelete: SetNull)
  reversedBy     Sale?   @relation("saleReversal")

  inputSource      String // telegram | web_form | import
  enteredByStaffId String?
  enteredByStaff   Staff?    @relation("saleEnteredBy", fields: [enteredByStaffId], references: [id], onDelete: SetNull)
  enteredAt        DateTime  @default(now()) // server-generated
  confirmedAt      DateTime?
  voidedAt         DateTime?

  notes String?

  lines           SaleLine[]
  staff           SaleStaff[]
  // Rows that point AT this sale, so nothing holds a bare id it can't resolve.
  closedCrmLeads  CrmLead[]       @relation("crmLeadClosingSale")
  closedB2bDeals  B2bDeal[]
  b2bPayments     B2bPayment[]
  footfallEntries FootfallEntry[]

  @@index([channel])
  @@index([status])
  @@index([dateAd])
  @@index([showroomKey, dateAd])
  @@index([enteredAt])
  @@index([crmLeadId])
  @@index([customerId])
}

// Line items with prices snapshotted at sale time — a later catalog price
// change must never rewrite what a past sale charged.
model SaleLine {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Snapshots (survive renames, variant retirement, and price edits).
  productName  String
  variantLabel String?
  sku          String?

  qty          Int
  unitMrp      Int? // catalog MRP at the time, for discount reporting
  unitPrice    Int // what was actually charged per unit
  lineDiscount Int     @default(0)
  lineTotal    Int // qty × unitPrice − lineDiscount
  note         String?

  @@index([saleId])
  @@index([variationId])
  @@index([productId])
}

// A sale often involves more than one person ("Deepak / Nirjala" in the old
// registers), so attribution is many-to-many with a role.
model SaleStaff {
  saleId  String
  sale    Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role    String // sold_by | assisted | delivered

  @@id([saleId, staffId, role])
  @@index([staffId])
}

// Single-row atomic counter for sale numbers, incremented inside the confirm
// transaction so concurrent confirms can't collide on saleNo.
model SaleCounter {
  id    Int @id @default(1)
  value Int @default(0)
}

// ─── Reporting system: B2B / wholesale (PR 5 — Module C) ─────────────────────
// The pipeline and tier structure are lifted from the existing Shrawan target
// list so past workbooks map straight across. Payment terms, advances and
// outstanding balance are genuinely new capability — nothing tracked them
// before, and B2B carries the bulk of the target.

model B2bTier {
  // 1 | 2 | 3 — the tier IS the identity, so it doubles as the primary key.
  tier            Int     @id
  label           String  @unique // "Tier 1" …
  minOrderValue   Int // NPR, inclusive
  maxOrderValue   Int? // null on the top tier (unbounded)
  discountPct     Int // off MRP
  targetMarginPct Int // gross margin we aim to keep at this tier
  commissionPct   Int // paid to the account/agent
  active          Boolean @default(true)

  accounts B2bAccount[]
  deals    B2bDeal[]    @relation("b2bDealTierApplied")
}

model B2bAccount {
  id            String  @id @default(cuid())
  companyName   String
  // Contact block — a trade account is a company, but one human answers.
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  panNo         String? // Nepali tax id, needed for invoicing

  accountType String // hotel | spa | interior | retailer | exporter | other
  tier        Int?
  // Restrict, not SetNull: a tier carries live commercial terms, so deleting one
  // must fail loudly rather than silently blanking every account's discount.
  tierData    B2bTier? @relation(fields: [tier], references: [tier], onDelete: Restrict)
  status      String   @default("prospect") // prospect | active | dormant | lost

  ownerStaffId String?
  ownerStaff   Staff?  @relation("b2bAccountOwner", fields: [ownerStaffId], references: [id], onDelete: SetNull)

  // Where the account came from (spec decision #12: a wholesale-interest lead
  // converts to a trade account).
  sourceCrmLeadId String?
  sourceCrmLead   CrmLead? @relation("b2bAccountFromLead", fields: [sourceCrmLeadId], references: [id], onDelete: SetNull)

  showroomKey String? // the showroom that services this account, if any
  notes       String?

  createdByStaffId String?
  createdByStaff   Staff?   @relation("b2bAccountCreator", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deals           B2bDeal[]
  payments        B2bPayment[]
  sales           Sale[]
  // Leads whose linkedB2bAccountId points here (the mirror of sourceCrmLead).
  linkedFromLeads CrmLead[]    @relation("crmLeadLinkedAccount")

  @@index([status])
  @@index([accountType])
  @@index([tier])
  @@index([ownerStaffId])
  @@index([createdAt])
}

model B2bDeal {
  id           String     @id @default(cuid())
  b2bAccountId String
  b2bAccount   B2bAccount @relation(fields: [b2bAccountId], references: [id], onDelete: Cascade)

  dealName String
  // Verbatim from the existing Shrawan target list, so old sheets map across.
  stage    String @default("contacted") // contacted | meeting_set | samples_sent | quoted | negotiating | won | lost | deferred

  quoteAmount       Int? // NPR; recomputed from quote lines when they exist
  expectedCloseDate DateTime?

  ownerStaffId String?
  ownerStaff   Staff?  @relation("b2bDealOwner", fields: [ownerStaffId], references: [id], onDelete: SetNull)

  tierApplied Int?
  tierData    B2bTier? @relation("b2bDealTierApplied", fields: [tierApplied], references: [tier], onDelete: Restrict)

  // Set when the deal is won and invoiced through the sales spine — this is
  // what connects a quote to the revenue it produced.
  linkedSaleId String?
  linkedSale   Sale?   @relation(fields: [linkedSaleId], references: [id], onDelete: SetNull)

  dateAd DateTime @default(now())
  dateBs String

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageHistory B2bDealStageHistory[]
  quoteLines   B2bQuoteLine[]

  @@index([b2bAccountId])
  @@index([stage])
  @@index([ownerStaffId])
  @@index([expectedCloseDate])
  @@index([dateAd])
}

// APPEND-ONLY: a stage is never overwritten in place. "Samples sent on the 4th,
// quoted on the 9th" is the reportable fact, not just the current stage.
model B2bDealStageHistory {
  id     String  @id @default(cuid())
  dealId String
  deal   B2bDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  fromStage String? // null on the row written at deal creation
  toStage   String

  changedByStaffId String
  changedByStaff   Staff  @relation(fields: [changedByStaffId], references: [id], onDelete: Restrict)

  note      String?
  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
  @@index([createdAt])
}

// Column-for-column the Bhaktapur cost-calculation sheet, so a quote can be
// checked against the workbook it replaces. Derived columns are computed
// server-side (lib/b2b), never typed.
model B2bQuoteLine {
  id     String  @id @default(cuid())
  dealId String
  deal   B2bDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  // Snapshots, so a later catalog edit can't rewrite a quote already sent.
  productName  String
  variantLabel String?
  sku          String?

  qty                Int
  mrp                Int // catalog price per unit
  wholesaleRate      Int // agreed trade price per unit
  discountAmount     Int // (mrp − wholesaleRate) × qty
  discountPct        Int // rounded percentage off MRP
  costPrice          Int? // per unit, when known — admin-only
  lineTotalMrp       Int // qty × mrp
  lineTotalWholesale Int // qty × wholesaleRate
  marginAmount       Int? // lineTotalWholesale − (qty × costPrice)
  marginPct          Int? // marginAmount / lineTotalWholesale
  note               String?

  @@index([dealId])
  @@index([productId])
  @@index([variationId])
}

// Money actually received. `isAdvance` marks a payment taken before delivery,
// which is how outstanding balance stays honest on staged orders.
model B2bPayment {
  id           String     @id @default(cuid())
  b2bAccountId String
  b2bAccount   B2bAccount @relation(fields: [b2bAccountId], references: [id], onDelete: Cascade)

  // Optional link to the invoiced sale. A general advance has no sale yet.
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  amount Int // NPR
  paidAt DateTime @default(now())
  dateBs String

  paymentMethodId String?
  paymentMethod   PaymentMethodLookup? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  isAdvance Boolean @default(false)
  reference String? // cheque no., transfer ref
  note      String?

  recordedByStaffId String
  recordedByStaff   Staff  @relation(fields: [recordedByStaffId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([b2bAccountId, paidAt])
  @@index([saleId])
  @@index([paidAt])
}

// ─── Reporting system: marketing & footfall (PR 6 — Module D) ────────────────
// Replaces four hand-kept surfaces: the footfall sheet whose multi-product days
// spilled onto blank-date continuation rows (now FootfallInquiry rows against
// one entry), the monthly social tally, the content log CSV, and the Meta ad
// export — which is denominated in AUD, so currency and FX rate are mandatory
// here rather than optional.

model FootfallEntry {
  id          String   @id @default(cuid())
  dateAd      DateTime
  dateBs      String
  showroomKey String
  showroom    Showroom @relation(fields: [showroomKey], references: [key], onDelete: Cascade)

  // visitorsTotal is the headline count. individuals/groups describe its
  // composition and are NOT required to add up — the old sheets often recorded
  // one without the other, and forcing equality would mean refusing real data.
  visitorsTotal Int
  individuals   Int?
  groups        Int?

  source String // walk_in | ad | referral | event | passing

  convertedToSale Boolean @default(false)
  linkedSaleId    String?
  linkedSale      Sale?   @relation(fields: [linkedSaleId], references: [id], onDelete: SetNull)

  enteredByStaffId String
  enteredByStaff   Staff    @relation(fields: [enteredByStaffId], references: [id], onDelete: Restrict)
  enteredAt        DateTime @default(now())
  notes            String?

  inquiries FootfallInquiry[]

  @@index([showroomKey, dateAd])
  @@index([dateAd])
  @@index([source])
  @@index([convertedToSale])
}

// What a visitor asked about. `freeTextProduct` exists because staff record
// things the catalog doesn't have yet — refusing that would push the data back
// into a notebook.
model FootfallInquiry {
  id              String        @id @default(cuid())
  footfallEntryId String
  footfallEntry   FootfallEntry @relation(fields: [footfallEntryId], references: [id], onDelete: Cascade)

  variationId     String?
  variation       ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  freeTextProduct String?

  inquiryType String // inquired | sold

  @@index([footfallEntryId])
  @@index([variationId])
  @@index([inquiryType])
}

model SocialMetricsMonthly {
  id       String   @id @default(cuid())
  periodBs String // "2083-04" — the Nepali month the report is filed under
  periodAd DateTime // first day of the corresponding AD month
  platform String // instagram | facebook | tiktok | youtube

  followers      Int?
  newFollowers   Int?
  posts          Int?
  stories        Int?
  reels          Int?
  reach          Int?
  impressions    Int?
  profileVisits  Int?
  avgLikes       Int?
  avgComments    Int?
  avgSharesSaves Int?
  // Percentage, e.g. 5.25. Decimal because rounding an engagement rate to a
  // whole number loses the signal it exists to carry.
  engagementRate Decimal? @db.Decimal(6, 2)

  source     String // manual | api | csv_import
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // One row per month per platform, so re-importing a month corrects it rather
  // than adding a second truth.
  @@unique([periodBs, platform])
  @@index([periodAd])
  @@index([platform])
}

// Column-for-column the existing ShamanKTM-MarketingReportTemplate content log,
// so the CSV imports without reshaping.
model ContentLog {
  id          String   @id @default(cuid())
  date        DateTime
  dateBs      String
  platform    String // instagram | facebook | tiktok | youtube
  contentType String // post | reel | story | video | carousel | …
  topic       String?
  hashtags    String?

  reach          Int?
  impressions    Int?
  likes          Int?
  comments       Int?
  shares         Int?
  saves          Int?
  engagementRate Decimal? @db.Decimal(6, 2)
  linkClicks     Int?

  notes String?

  enteredByStaffId String?
  enteredByStaff   Staff?  @relation(fields: [enteredByStaffId], references: [id], onDelete: SetNull)

  source    String   @default("manual") // manual | csv_import
  createdAt DateTime @default(now())

  @@index([date])
  @@index([platform])
}

model AdSpendDaily {
  id           String   @id @default(cuid())
  dateAd       DateTime
  dateBs       String
  platform     String // facebook | instagram | tiktok | google | …
  // Empty string, not null, for "no campaign". A NULL member of a compound
  // unique key is treated as distinct by Postgres, so campaign-less rows would
  // never dedupe — and Prisma refuses null in the upsert key outright. The
  // sentinel keeps "one row per campaign-day" true for every row.
  campaignName String   @default("")

  // The Meta export is denominated in AUD, so the original amount, its currency
  // and the rate used are all recorded, and the NPR figure every report reads
  // is materialized from them at write time. Storing only a converted number
  // would make the conversion unauditable.
  amountSpent Decimal @db.Decimal(14, 2)
  currency    String // AUD | NPR | USD | …
  fxRate      Decimal @db.Decimal(14, 6) // 1 <currency> = fxRate NPR
  amountNpr   Int // round(amountSpent × fxRate)

  impressions            Int?
  reach                  Int?
  frequency              Decimal? @db.Decimal(8, 2)
  results                Int?
  costPerResult          Decimal? @db.Decimal(14, 2)
  messagingConversations Int?

  source String // manual | api | csv_import

  enteredByStaffId String?
  enteredByStaff   Staff?  @relation(fields: [enteredByStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per campaign per platform per day; a re-import corrects in place.
  @@unique([dateAd, platform, campaignName])
  @@index([dateAd])
  @@index([platform])
}
